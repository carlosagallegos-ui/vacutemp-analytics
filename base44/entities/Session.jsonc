{
  "name": "Session",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la sesi\u00f3n de medici\u00f3n"
    },
    "notes": {
      "type": "string",
      "description": "Notas del experimento"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "stopped"
      ],
      "default": "active"
    },
    "sample_interval_ms": {
      "type": "number",
      "description": "Intervalo de muestreo en milisegundos",
      "default": 1000
    },
    "data_points": {
      "type": "array",
      "description": "Puntos de datos registrados",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "number"
          },
          "T1": {
            "type": "number",
            "description": "Temperatura Celda 1 (\u00b0C)"
          },
          "T2": {
            "type": "number",
            "description": "Temperatura Celda 2 (\u00b0C)"
          },
          "T3": {
            "type": "number",
            "description": "Temperatura Portasustrato (\u00b0C)"
          },
          "I1": {
            "type": "number",
            "description": "Corriente Celda 1 (A)"
          },
          "I2": {
            "type": "number",
            "description": "Corriente Celda 2 (A)"
          },
          "I3": {
            "type": "number",
            "description": "Corriente Portasustrato (A)"
          },
          "P": {
            "type": "number",
            "description": "Presi\u00f3n C\u00e1mara (Torr)"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ]
}